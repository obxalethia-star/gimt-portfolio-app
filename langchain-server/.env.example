# Reference only: install_local_ai.sh writes /opt/qhf-ai/.env with values sized for your server
# (and generates QHF_API_KEY). Re-run the installer instead of editing by hand.
QHF_API_KEY=
TEXT_BASE_MODEL=llama3.1:8b
VISION_BASE_MODEL=gemma3:4b
# Local copies of the base models with this server's thread count and context window.
TEXT_MODEL=qhf-text
VISION_MODEL=qhf-vision
NUM_CTX=8192
NUM_THREAD=3
TEMPERATURE=0.3
KEEP_ALIVE=10m
OLLAMA_BASE_URL=http://qhf-ollama:11434
OLLAMA_CPUS=3
OLLAMA_MEM_MB=16000
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_PORT=11434
LANGCHAIN_PORT=8000

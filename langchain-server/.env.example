# Copied to /opt/qhf-langchain/.env by setup_oracle_vm.sh (which also generates QHF_API_KEY).
QHF_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Text model for /market, /news, /analyze and chat. Larger = better but slower on a CPU-only VM.
TEXT_MODEL=llama3.1:8b
# Must be a vision-capable model; used for chart screenshots.
VISION_MODEL=gemma3:4b
NUM_CTX=8192
TEMPERATURE=0.3
KEEP_ALIVE=30m
